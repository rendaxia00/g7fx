  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "主要学习动作，证据薄荷填充与短促抬升。",
      "html": "<button class=\"ds-button-primary\">开始学习</button>",
      "css": ".ds-button-primary{min-height:44px;padding:0 19px;border:0;border-radius:10px;background:var(--mint,#45e4bd);color:#05231b;font:700 13px/1.7 \"Noto Sans SC\",sans-serif;cursor:pointer;box-shadow:0 10px 28px rgba(0,0,0,.22);transition:.2s ease}.ds-button-primary:hover{transform:translateY(-2px);filter:brightness(1.08)}.ds-button-primary:active{transform:translateY(0)}.ds-button-primary:focus-visible{outline:2px solid var(--mint,#45e4bd);outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "次级动作，以边框和文字状态表达交互。",
      "html": "<button class=\"ds-button-ghost\">查看学习路线</button>",
      "css": ".ds-button-ghost{min-height:44px;padding:0 19px;border:1px solid rgba(159,209,197,.24);border-radius:10px;background:rgba(255,255,255,.02);color:var(--text,#e9f5f2);font:700 13px/1.7 \"Noto Sans SC\",sans-serif;cursor:pointer;transition:.2s ease}.ds-button-ghost:hover{border-color:var(--mint,#45e4bd);color:var(--mint,#45e4bd)}.ds-button-ghost:focus-visible{outline:2px solid var(--mint,#45e4bd);outline-offset:3px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "全局知识检索入口，保持低对比但持续可见。",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-4-4\"/></svg><input type=\"search\" placeholder=\"搜索知识点、章节或术语\"></label>",
      "css": ".ds-search{height:38px;display:flex;align-items:center;gap:10px;padding:0 11px;border:1px solid rgba(159,209,197,.13);border-radius:10px;background:var(--panel,#0d1c21);color:var(--scale-gray,#88a39d);transition:.2s ease}.ds-search:focus-within{border-color:var(--mint,#45e4bd);box-shadow:0 0 0 2px rgba(69,228,189,.12)}.ds-search svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7}.ds-search input{width:100%;border:0;outline:0;background:transparent;color:var(--text,#e9f5f2);font:400 12px/1.7 \"Noto Sans SC\",sans-serif}.ds-search input::placeholder{color:var(--scale-gray,#88a39d)}"
    },
    {
      "name": "Active Navigation Item",
      "kind": "nav",
      "description": "侧栏当前章节定位，使用左侧证据线。",
      "html": "<a class=\"ds-nav-active\" href=\"#\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5z\"/><path d=\"M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5z\"/></svg><span>课程章节</span></a>",
      "css": ".ds-nav-active{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;background:rgba(69,228,189,.09);box-shadow:inset 3px 0 0 var(--mint,#45e4bd);color:var(--mint,#45e4bd);font:600 14px/1.7 \"Noto Sans SC\",sans-serif;text-decoration:none}.ds-nav-active svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7}.ds-nav-active:hover{background:rgba(69,228,189,.13)}.ds-nav-active:focus-visible{outline:2px solid var(--mint,#45e4bd);outline-offset:3px}"
    },
    {
      "name": "Course Card",
      "kind": "card",
      "refersTo": "course-card",
      "description": "章节索引卡，依靠编号、分类、摘要和时长建立扫描顺序。",
      "html": "<a class=\"ds-course-card\" href=\"#\"><div class=\"ds-card-top\"><strong>P04</strong><span>拍卖市场理论</span></div><h3>AMT 1：拍卖市场与交易数据</h3><p>从价值、接受与失衡建立市场情境。</p><small>01:48:00 · 深度版</small></a>",
      "css": ".ds-course-card{min-height:220px;padding:20px;display:flex;flex-direction:column;border:1px solid rgba(159,209,197,.13);border-radius:15px;background:var(--panel,#0d1c21);color:var(--text,#e9f5f2);text-decoration:none;transition:.22s ease}.ds-course-card:hover{transform:translateY(-4px);border-color:rgba(69,228,189,.35);box-shadow:0 20px 60px rgba(0,0,0,.28)}.ds-course-card:focus-visible{outline:2px solid var(--mint,#45e4bd);outline-offset:3px}.ds-card-top{display:flex;justify-content:space-between;gap:12px}.ds-card-top strong{color:var(--mint,#45e4bd);font:800 12px Manrope,sans-serif}.ds-card-top span{padding:4px 8px;border:1px solid rgba(159,209,197,.13);border-radius:999px;color:var(--scale-gray,#88a39d);font:700 12px \"Noto Sans SC\",sans-serif}.ds-course-card h3{margin:24px 0 10px;font:700 16px/1.45 \"Noto Sans SC\",sans-serif}.ds-course-card p{margin:0;color:var(--scale-gray,#88a39d);font:400 12px/1.7 \"Noto Sans SC\",sans-serif}.ds-course-card small{margin-top:auto;padding-top:18px;color:var(--scale-gray,#88a39d);font:600 12px Manrope,sans-serif}"
    },
    {
