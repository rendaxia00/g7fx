  "narrative": {
    "northStar": "订单流作战手册",
    "overview": "这套系统像一本在交易台旁反复翻阅的专业训练手册：深色基底压低环境噪声，证据薄荷只标记可行动、可定位或已激活的信息。它不模拟交易所，也不追求刺激感；设计的任务是让章节结构、术语关系和证据位置更容易被理解与复习。\n\n界面以冷静的二维分层和紧凑但不拥挤的信息密度组织内容。大标题建立章节方向，Manrope 标签和数字承担索引功能，Noto Sans SC 负责连续中文阅读。细边框比阴影更常用，阴影仅用于关键面板或交互抬升。",
    "keyCharacteristics": [
      "专业、冷静、严谨，并保持明确的教学导向。",
      "以章节、证据和复习路径为中心，而不是模拟实时交易终端。",
      "深色优先并提供语义一致的浅色主题。",
      "强调色克制使用，信息层级主要依靠字号、间距、边框和表面色差建立。",
      "动效短促、功能性明确，并尊重减少动态效果偏好。"
    ],
    "rules": [
      {
        "name": "证据色稀缺规则",
        "body": "证据薄荷只用于交互、定位、状态和结构锚点；不得把整屏变成霓虹绿光或交易所促销界面。",
        "section": "colors"
      },
      {
        "name": "语义颜色守恒规则",
        "body": "蓝、琥珀和红保持稳定的概念分类含义，不因页面不同而随意换色。",
        "section": "colors"
      },
      {
        "name": "双通道排版规则",
        "body": "Noto Sans SC 承担知识解释，Manrope 承担索引与数据；不得让大段中文正文使用 Manrope，也不得用多种展示字体制造装饰性层级。",
        "section": "typography"
      },
      {
        "name": "阅读轴优先规则",
        "body": "长篇知识内容始终保持清晰的单一阅读轴；辅助目录、视频和翻页控件服务于定位，不与正文争夺主视觉。",
        "section": "layout"
      },
      {
        "name": "默认平面规则",
        "body": "普通卡片静止时依靠色面和边框分层；阴影只作为重点层级或交互反馈，不成为所有容器的常驻装饰。",
        "section": "elevation"
      }
    ],
    "dos": [
      "让章节编号、标题、摘要、视频、正文和复习问题形成稳定的学习顺序。",
      "用证据薄荷标记交互与定位，用刻度灰承载辅助信息。",
      "优先通过字号、留白、表面色差和细边框建立层级。",
      "同时验证深色、浅色、桌面和移动布局。",
      "保留清楚的键盘焦点、减少动态效果模式和可读中文行高。"
    ],
    "donts": [
      "引入交易所广告感、加密货币霓虹风、游戏化徽章或拥挤数据大屏。",
      "把证据薄荷扩张为大面积发光背景或持续闪烁效果。",
      "使用无信息价值的装饰图表、收益数字或虚构实时行情。",
      "让多个卡片都使用常驻重阴影，也不要用玻璃拟态替代真实层级。",
      "用过多英文、缩写或极小字号增加专业感；教学可读性始终优先。"
    ]
  }
}
